<!DOCTYPE html>
<html>
<head>
  <title>Diario del blogero</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: linear-gradient(135deg, #667eea, #764ba2);
      margin: 0;
      padding: 20px;
      color: #333;
    }

    h1 {
      text-align: center;
      color: #fff;
    }

    .container {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 20px;
      margin-top: 30px;
    }

    .card {
      background: rgba(255, 255, 255, 0.7);
      border-radius: 15px;
      padding: 20px;
      backdrop-filter: blur(10px);
      box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
      transition: transform 0.2s ease-in-out;
    }

    .card:hover {
      transform: translateY(-5px);
    }

    .card h2 {
      margin: 0 0 10px;
      font-size: 20px;
      color: #222;
    }

    .card p {
      font-size: 14px;
      line-height: 1.4;
      color: #444;
    }

    .card .meta {
      margin-top: 10px;
      font-size: 12px;
      color: #666;
    }

    .actions {
      margin-top: 15px;
      display: flex;
      justify-content: space-between;
    }

    .actions a, .actions form button {
      background: #4a00e0;
      color: #fff;
      border: none;
      padding: 6px 12px;
      border-radius: 8px;
      cursor: pointer;
      text-decoration: none;
      font-size: 12px;
      transition: background 0.3s;
    }

    .actions a:hover, .actions form button:hover {
      background: #8e2de2;
    }

    .add-post {
      display: block;
      width: fit-content;
      margin: 0 auto;
      margin-top: 20px;
      background: #fff;
      color: #4a00e0;
      font-weight: bold;
      padding: 10px 20px;
      border-radius: 12px;
      text-decoration: none;
      box-shadow: 0 4px 10px rgba(0,0,0,0.2);
      transition: background 0.3s, color 0.3s;
    }

    .add-post:hover {
      background: #4a00e0;
      color: #fff;
    }
  </style>
</head>
<body>
  <h1>Lista de Posts</h1>

  <!-- Botón para crear nuevo Post (usa el ID del usuario predeterminado) -->
  <a href="/posts/new/68d83294046258c70a147fb0" class="add-post">➕ Crear nuevo Post</a>

  <div class="container">
    <% posts.forEach(post => { %>
      <div class="card">
        <h2><%= post.title %></h2>
        <p><%= post.content %></p>
        <% if (post.imageUrl) { %>
          <img src="<%= post.imageUrl %>" alt="Imagen del post" style="width:100%; margin-top:10px; border-radius:10px;">
        <% } %>
        <% if (post.hashtags && post.hashtags.length > 0) { %>
          <p class="meta">#<%= post.hashtags.join(" #") %></p>
        <% } %>
        <p class="meta">Creado por: <%= post.user?.name || "Usuario desconocido" %></p>

        <div class="actions">
          <a href="/posts/<%= post._id %>/edit">✏️ Editar</a>
          <form action="/posts/<%= post._id %>/delete" method="POST">
            <button type="submit">🗑️ Eliminar</button>
          </form>
        </div>
      </div>
    <% }) %>
  </div>
</body>
</html>
